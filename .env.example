# Harbor backend configuration. Copy to .env to override defaults.

# Soroban RPC endpoint.
# RPC_URL=https://soroban-testnet.stellar.org

# Deployed C-address of the hedegpay_batch contract.
# CONTRACT_ID=CD4U2T3X5K7G2J6L4A8B9Z1Y0W_MOCK_CONTRACT_ID

# Base settlement token label surfaced in the API (token symbol).
# TOKEN_SYMBOL=USDC

# Decimal places of the base settlement token.
# TOKEN_DECIMALS=6

# HTTP server host/port.
# HOST=0.0.0.0
# PORT=8787

# Event listener poll interval in ms.
# POLL_INTERVAL_MS=5000

# How many ledgers back to start indexing from on first run.
# START_LEDGER_BACK=10

# SQLite database path.
# DB_PATH=./data/harbor.db